class Solution:
    def threeSum(self, arr):
        res=[]
        arr.sort()
        for i in range(len(arr)):
            if arr[i]>0:
                break
            if i>0 and arr[i]==arr[i-1]:
                continue
            low=i+1
            high=len(arr)-1
            while low<high:
                current=arr[i]+arr[low]+arr[high]
                if current<0:
                    low+=1
                elif current>0:
                    high-=1
                else:
                    res.append([arr[i],arr[low],arr[high]])
                    low+=1
                    high-=1
                    while low<high and arr[low]==arr[low-1]:
                        low+=1
        return res


