class Solution:
    def sortColors(self, nums: list[int]) -> None:
        n=len(nums)-1
        i=0
        while i<n:
            if nums[i]==2:
                nums[i],nums[n]=nums[n],nums[i]
                n-=1
            else:
                i+=1
        l,r=0,len(nums)-1
        while l<r:
            if nums[r]==0:
                nums[l],nums[r]=nums[r],nums[l]
                l+=1
            else:
                r-=1
                
