class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        num=nums1+nums2
        num.sort()
        n=len(num)
        m=n//2
        if n%2==0:
            res=(num[m]+num[m-1])/2
        else:
            return num[m]
        return res

        
