class Solution:
    def subarraySum(self, arr: List[int], k: int) -> int:
        seen={0:1}
        count=0
        current=0
        n=len(arr)
        for i in range(n):
            current+=arr[i]
            if current-k in seen:
                count+=seen[current-k]
         
            seen[current]=seen.get(current,0)+1
        return count

        
