class Solution:
    def uniquePathsWithObstacles(self, Grid: List[List[int]]) -> int:
        m=len(Grid)
        n=len(Grid[0])
        dp=[[0]*n for _ in range(m)]

        if Grid[0][0]==0:
            dp[0][0]=1
        else:
            dp[0][0]=0 

        for i in range(1,m):
            if Grid[i][0]==0:
                dp[i][0]=dp[i-1][0]

        for j in range(1,n):
            if Grid[0][j]==0:
                dp[0][j]=dp[0][j-1]
        
        for i in range(1,m):
            for j in range(1,n):
                if Grid[i][j]==1:
                    dp[i][j]=0
                else:
                    dp[i][j]=dp[i-1][j]+dp[i][j-1]
        return dp[m-1][n-1]


        
