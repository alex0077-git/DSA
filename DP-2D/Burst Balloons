class Solution:
    def maxCoins(self, nums: List[int]) -> int:
        nums=[x for x in nums if x>0]
        nums=[1]+nums+[1]
        n=len(nums)
        dp=[[0]*n for _ in range(n)]

        for windowlen in range(2,n):
            for left in range(n-windowlen):
                right=left+windowlen
                maxx=0
                for i in range(left+1,right):
                    current=(nums[left]*nums[i]*nums[right]+dp[left][i]+dp[i][right])
                    maxx=max(maxx,current)
                
                dp[left][right]=maxx
        return dp[0][n-1]
        

        
