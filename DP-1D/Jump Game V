class Solution:
    def maxJumps(self, arr: List[int], d: int) -> int:
        n=len(arr)
        dp=[1]*n
        order=sorted(range(n), key=lambda x:arr[x])

        for i in order:
            for j in range(i+1,min(i+d+1,n)):
                if arr[j]>=arr[i]:
                    break
                dp[i]=max(dp[i],1+dp[j])
            for j in range(i-1,max(i-d-1,-1),-1):
                if arr[j]>=arr[i]:
                    break
                dp[i]=max(dp[i],1+dp[j])
        return max(dp)
