class Solution:
    def rob(self, arr):
        n=len(arr)
        if n==0:
            return 0
        if n==1:
            return arr[0]
        dp=[0]*(n+1)
        dp[0]=arr[0]
        dp[1]=max(arr[1],arr[0])
        
        for i in range(2,n):
            dp[i]=max(dp[i-1],arr[i]+dp[i-2])
        return dp[n-1]


