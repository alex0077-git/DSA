class Solution:
    def knightDialer(self, n: int) -> int:
        if n==1:
            return 10
        MOD=10**9+7

        v0=v1=v2=v3=v4=v5=v6=v7=v8=v9=1
        for _ in range(n-1):
            n0=(v4+v6)%MOD
            n1=(v8+v6)%MOD
            n2=(v7+v9)%MOD
            n3=(v8+v4)%MOD
            n4=(v3+v9+v0)%MOD
            n5=0
            n6=(v1+v7+v0)%MOD
            n7=(v2+v6)%MOD
            n8=(v1+v3)%MOD
            n9=(v2+v4)%MOD
            n0=(v4+v6)%MOD

            v1,v2,v3,v4,v5,v6,v7,v8,v9,v0=n1,n2,n3,n4,n5,n6,n7,n8,n9,n0
        return( v1+v2+v3+v4+v5+v6+v7+v8+v9+v0)%MOD

        
