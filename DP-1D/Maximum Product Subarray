class Solution:
    def maxProduct(self, arr):
        maxx=minn=res=arr[0]
        for i in range(1,len(arr)):
            if arr[i]<0:
                minn,maxx=maxx,minn
            maxx=max(arr[i],arr[i]*maxx)
            minn=min(arr[i],arr[i]*minn)
            res=max(res,maxx)
        return res
        
