class Solution:
    def mergeTwoLists(self, head1: Optional[ListNode], head2: Optional[ListNode]) -> Optional[ListNode]:

        dummy=ListNode(0)
        tail=dummy

        while head1 and head2:
            if head1.val<head2.val:
                tail.next=head1
                head1=head1.next
            else:
                tail.next=head2
                head2=head2.next

            tail=tail.next

        if head1:
            tail.next=head1
        else:
            tail.next=head2
        return dummy.next       
