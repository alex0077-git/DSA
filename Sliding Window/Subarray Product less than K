class Solution:
    def numSubarrayProductLessThanK(self, nums: List[int], k: int) -> int:

        if k<=1:
            return 0
        n=len(nums)
        left=0
        count=0
        product=1
        for i in range(n):
            product*=nums[i]

            while product>=k:
                product=product//nums[left]
                left+=1
            count+=i-left+1
        return count
