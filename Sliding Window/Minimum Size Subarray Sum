class Solution:
    def minSubArrayLen(self, target: int, nums: List[int]) -> int:
        left=0
        current=0
        minn=float('inf')
        n=len(nums)
        for right in range(n):
            current+=nums[right]
            
            while current>=target:
                minn=min(minn,right-left+1)

                current-=nums[left]
                left+=1
        if minn==float('inf'):
            return 0
        return minn
