class Solution:
    def lengthOfLongestSubstring(self, s):
        seen=set()
        current,maxx=0,0
        for i in range(len(s)):
            while s[i] in seen:
                seen.remove(s[current])
                current+=1
            seen.add(s[i])
            maxx=max(maxx,i-current+1)
        return maxx
