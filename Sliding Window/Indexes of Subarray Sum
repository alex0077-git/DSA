class Solution:
    def subarraySum(self, arr, target):
        # code here
        n=len(arr)
        left=0
        summ=0
        for right in range(n):
            summ+=arr[right]
            while summ>target and left<=right:
                summ-=arr[left]
                left+=1
            if summ==target:
                return [left+1,right+1]
            
        return [-1]
