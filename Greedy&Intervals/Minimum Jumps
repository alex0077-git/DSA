class Solution:
	def minJumps(self, arr):
	    # code here
	    n=len(arr)
	    if n<=1:
	        return 0
	    if arr[0]==0:
	        return -1
	        
	    jumps=0
	    current=0
	    currentend=0
	    for i in range(n-1):
	        current=max(current,i+arr[i])
	        if i==currentend:
	            jumps+=1
	            currentend=current
	            if currentend>=n-1:
	                return jumps
	            if currentend<=i:
	                return -1
	    return -1
	            
	       

	            
	            
	            
