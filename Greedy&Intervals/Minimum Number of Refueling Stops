import heapq
class Solution:
    def minRefuelStops(self, target: int, startFuel: int, stations: List[List[int]]) -> int:
        n=len(stations)
        heap=[]
        i=0
        stops=0
        fuel=startFuel
        while fuel<target:
            while i<n and stations[i][0]<=fuel:
                heapq.heappush(heap,-stations[i][1])
                i+=1
            if not heap:
                return -1
            fuel+= -heapq.heappop(heap)
            stops+=1
        return stops
        
