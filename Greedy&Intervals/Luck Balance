def luckBalance(k, contests):
    # Write your code here
    luck=0
    r=k
    contests.sort(reverse=True)
    for i in range(len(contests)):
        if contests[i][1]==0:
            luck+=contests[i][0]
        elif r>0:
            luck+=contests[i][0]
            r-=1   
        else:
            luck-=contests[i][0]    
    return luck
