class Solution:
    def longestPalindrome(self, s: str) -> str:
            if not s:
                return ""
            start,end=0,0
            def values(left,right):
                while left>=0 and right<len(s) and s[left]==s[right]:
                    left-=1
                    right+=1
                return right-left-1
            for i in range(len(s)):
                len1=values(i,i)
                len2=values(i,i+1)
                maxlen=max(len1,len2)
                if maxlen>end-start+1:
                    start=i-(maxlen-1)//2
                    end=i+maxlen//2
            return s[start:end+1]

        
