class Solution:
    def mergeAlternately(self, word1: str, word2: str) -> str:
        l1=len(word1)
        l2=len(word2)
        mer=""
        for i in range(max(l1,l2)):
            if i<l1:
                mer+=word1[i]
            if i<l2:
                mer+=word2[i]
        return "".join(mer)
