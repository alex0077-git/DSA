class Solution:
    def orangesRotting(self, grid: List[List[int]]) -> int:
        rows=len(grid)
        cols=len(grid[0])
        current=[]
        fresh=0
        for r in range(rows):
            for c in range(cols):
                if grid[r][c]==2:
                    current.append((r,c))
                elif grid[r][c]==1:
                    fresh+=1
        if fresh==0:
            return 0
        minutes=0
        direction=[(1,0),(0,1),(-1,0),(0,-1)]

        while current:
            next=[]
            for r,c in current:
                for dr,dc in direction:
                    nr,nc=r+dr,c+dc

                    if 0<=nr<rows and 0<=nc<cols and grid[nr][nc]==1:
                        grid[nr][nc]=2
                        fresh-=1
                        next.append((nr,nc))
            if next:
                minutes+=1
            current=next
        return minutes if fresh==0 else -1
