class Solution:
    def openLock(self, deadends: List[str], target: str) -> int:
        visited=set(deadends)
        if "0000" in visited:
            return -1
        current=["0000"]
        visited.add("0000")
        turns=0

        while current:
            next=[]
            for lock in current:
                if lock==target:
                    return turns
                for i in range(4):
                    digit=int(lock[i])
                    for move in [-1,1]:
                        newdigit=(digit+move)%10
                        newlock=lock[:i]+str(newdigit)+lock[i+1:]
                        if newlock not in visited:
                            visited.add(newlock)
                            next.append(newlock)
            current=next
            turns+=1
        return -1
